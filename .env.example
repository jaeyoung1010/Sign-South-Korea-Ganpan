# Copy this file to .env.local and add a current Typecast API key.
# .env.local is ignored by Git.
TYPECAST_API_KEY=

# Optional: use only when Typecast returns more than one voice named 은경.
TYPECAST_VOICE_ID=

# Google AI Studio key used only by the local Gemini audio generator.
GEMINI_API_KEY=

# Optional Gemini TTS overrides. The app label assumes the default Kore voice.
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=clear and natural Korean pronunciation at a calm learning pace

