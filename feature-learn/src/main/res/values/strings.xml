    <string name="help_title">Help in Korea</string>
    <string name="help_description">Official phone services for moments when you need help while travelling.</string>
    <string name="help_1330_title">1330 Tourist Helpline</string>
    <string name="help_1330_description">Tourist information, interpretation, and tourist-complaint support in one place. English, Chinese, Japanese and Russian are available 24/7; some other languages run 08:00–19:00. In Korea: 1330 · From overseas: +82-2-1330.</string>
    <string name="help_1330_website">Open Seoul travel guide</string>
    <string name="help_emergency_title">112 Police · 119 Medical emergency</string>
    <string name="help_emergency_description">In an emergency, call and say “English please” or “Interpreter please” to ask for language support.</string>
    <string name="help_emergency_website">Open VisitKorea safety guide</string>
    <string name="help_bbb_title">1588-5644 BBB interpretation</string>
    <string name="help_bbb_description">Useful when you need to call a restaurant, hospital, or shop. Free volunteer interpretation is available 24/7 in 20 languages; standard call charges may apply.</string>
    <string name="help_bbb_website">Open BBB Korea</string>
    <string name="help_1345_title">1345 Immigration Contact Center</string>
    <string name="help_1345_description">Weekdays 09:00–22:00, with immigration, visa, and stay information in 20 languages. After 18:00, Korean, English, and Chinese are the main consultation languages.</string>
    <string name="help_1345_website">Open Immigration Contact Center</string>
    <string name="help_lost_title">182 &amp; LOST112</string>
    <string name="help_lost_description">Use this service if you lose a passport, phone, wallet, or other belongings.</string>
    <string name="help_lost_website">Open LOST112</string>
